POSTGRES_DB=recall
POSTGRES_USER=recall_user
POSTGRES_PASSWORD=replace_with_a_secure_password

DATABASE_URL=postgresql+psycopg://recall_user:replace_with_a_secure_password@localhost:5432/recall
# Generate a unique secret of at least 32 characters for each deployment.
SECRET_KEY=replace_with_a_secure_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

APP_NAME=Recall API
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# Optional. Set to an absolute path on persistent storage when deploying.
# STORAGE_DIR=/var/lib/recall/documents
MAX_UPLOAD_SIZE=26214400

# Ollama must be reachable from the backend at this address.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=120

RAG_TOP_K=5

# Compose serves the frontend on this host port. Keep loopback binding when
# a host-level TLS reverse proxy is used; use 0.0.0.0 on platforms that route
# directly to the container port.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
VITE_API_URL=/api/v1

# Public VPS deployment: point this domain's A record at the server IP, then
# start with `docker compose --profile public up -d --build` for HTTPS via Caddy.
RECALL_DOMAIN=recall.example.com
