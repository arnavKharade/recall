# Backend environment reference. The application loads the project-root .env
# file; copy the root .env.example there for local development and Compose.
APP_NAME=Recall API
APP_ENV=production
API_V1_PREFIX=/api/v1

# Use a URL-safe password (for example, a hex string) so it can be placed in
# DATABASE_URL without percent-encoding special characters.
DATABASE_URL=postgresql+psycopg://recall_user:replace_with_url_safe_password@db:5432/recall
# Generate a unique secret of at least 32 characters. Never commit its value.
SECRET_KEY=replace_with_a_secure_random_secret_of_at_least_32_characters
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated exact browser origins. Use the public HTTPS site in production.
CORS_ORIGINS=https://recall.example.com

# Mount persistent storage at this path in production.
STORAGE_DIR=/var/lib/recall/documents
MAX_UPLOAD_SIZE=26214400

# Docker service name, not localhost, when backend runs in Compose.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=120
RAG_TOP_K=5
